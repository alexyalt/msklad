<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_idle"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/moveTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/moveRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>

        <Button
            android:id="@+id/labelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_button"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/offlineSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="@string/offline_mode"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/pendingLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/error_red"
            android:textSize="12sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/syncButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sync_description"
            android:src="@drawable/ic_sync" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/modeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        app:checkedButton="@+id/modeMixed"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/modeScanner"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mode_scanner"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/modeMixed"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mode_mixed"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/modeKeyboard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/mode_keyboard"
            android:textSize="12sp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <FrameLayout
        android:id="@+id/cameraFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="2.8"
        android:background="@color/black">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/scannerOffLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/scanner_is_off"
            android:textColor="@color/white"
            android:visibility="gone" />

        <Button
            android:id="@+id/scannerToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:text="@string/scanner_off" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/inputBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="3"
                android:hint="@string/code_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/codeEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSend"
                    android:inputType="number"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/quantity_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/quantityEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/docGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:checkedButton="@+id/docMove"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/docMove"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/doc_move"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/docSupply"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/doc_supply"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/docLoss"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/doc_loss"
                android:textSize="14sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <!--
        Зона результата прижата к кнопкам П/О/С (без центрирования и пустого места): 3 строки под
        наименование, 1 под код, 2 строки под итог сканирования, остаток высоты — под сообщения.
    -->
    <LinearLayout
        android:id="@+id/resultZone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4.2"
        android:gravity="top"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp">

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/resultName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:lines="3"
            android:maxLines="3"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/resultCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:lines="1"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/resultLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lines="2"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/resultMessage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_horizontal|top"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            app:autoSizeMaxTextSize="20sp"
            app:autoSizeMinTextSize="9sp"
            app:autoSizeStepGranularity="0.5sp"
            app:autoSizeTextType="uniform" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/recentScroll"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginBottom="4dp"
        android:paddingHorizontal="12dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/recentList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/keypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            style="@style/KeypadKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="0" />
        <Button
            style="@style/KeypadKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="1" />
        <Button
            style="@style/KeypadKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="2" />
        <Button
            style="@style/KeypadKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="3" />
        <Button
            style="@style/KeypadKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="4" />
        <Button
            style="@style/KeypadKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="5" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            style="@style/KeypadKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="6" />
        <Button
            style="@style/KeypadKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="7" />
        <Button
            style="@style/KeypadKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="8" />
        <Button
            style="@style/KeypadKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="9" />
        <Button
            style="@style/KeypadKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:tag="clear"
            android:contentDescription="@string/clear_description"
            android:text="C" />
        <Button
            android:id="@+id/keypadEnter"
            style="@style/KeypadKey"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:tag="enter"
            android:contentDescription="@string/send"
            android:text="→" />
    </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/keypadLarge"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="vertical"
        android:paddingHorizontal="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            style="@style/KeypadKeyLarge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="1" />
        <Button
            style="@style/KeypadKeyLarge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="2" />
        <Button
            style="@style/KeypadKeyLarge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="3" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            style="@style/KeypadKeyLarge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="4" />
        <Button
            style="@style/KeypadKeyLarge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="5" />
        <Button
            style="@style/KeypadKeyLarge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="6" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            style="@style/KeypadKeyLarge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="7" />
        <Button
            style="@style/KeypadKeyLarge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="8" />
        <Button
            style="@style/KeypadKeyLarge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="9" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <Button
            style="@style/KeypadKeyLarge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:tag="clear"
            android:contentDescription="@string/clear_description"
            android:text="C" />
        <Button
            style="@style/KeypadKeyLarge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="0" />
        <Button
            android:id="@+id/keypadLargeEnter"
            style="@style/KeypadKeyLarge"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:tag="enter"
            android:contentDescription="@string/send"
            android:text="→" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
